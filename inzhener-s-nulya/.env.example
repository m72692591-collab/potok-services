# Public Replit URL. Set after the app receives its *.replit.app address.
APP_PUBLIC_URL=
PORT=3000

# T-Business production payment flow.
PAYMENT_PROVIDER=tbank
TBANK_ENV=production
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
ORDER_HMAC_SECRET=

# Existing private course and order storage.
BLOB_READ_WRITE_TOKEN=

# NPD / "Мой налог" administration.
NPD_ADMIN_TOKEN=
CONTROL_PURCHASE_ENABLED=false
CONTROL_PURCHASE_TOKEN=

# Seller data may be overridden without changing source files.
BUSINESS_LEGAL_NAME=
BUSINESS_INN=
BUSINESS_OGRN=
BUSINESS_CONTACT_EMAIL=
BUSINESS_CONTACT_PHONE=
BUSINESS_ADDRESS=
BUSINESS_HOURS=

# Legacy Yandex deployment variables; not needed for Replit.
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_BUCKET=inzhener-s-nulya


# Funnel / messenger channels. Public URLs are safe to expose; tokens and webhook secrets are not.
TELEGRAM_BOT_URL=https://t.me/AnimaTactusGrowthBot
MAX_BOT_URL=

# GrowthBot webhook reuses an existing token when present.
# Supported token names (first non-empty wins):
# ENGINEER_TELEGRAM_BOT_TOKEN, GROWTH_TELEGRAM_BOT_TOKEN,
# TELEGRAM_BOT_TOKEN, ANIMA_TACTUS_TELEGRAM_BOT_TOKEN.
# Store real values only in the cloud environment secret store.
ENGINEER_TELEGRAM_BOT_TOKEN=
GROWTH_TELEGRAM_BOT_TOKEN=
ENGINEER_TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
